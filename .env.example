# ============================================================
# El Tesorero — variables de entorno para pruebas de staging
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube al repositorio (está en .gitignore).
#
# ⚠️  Staging únicamente. NUNCA uses credenciales de producción:
#     Producción (NO TOCAR): https://tmjqzaakzhecbldebyeg.supabase.co
# ============================================================

# URL del proyecto de staging
STAGING_URL=https://rucgmytyxpfowznowxwd.supabase.co

# Anon key del proyecto de staging
# (Supabase dashboard → proyecto → Settings → API → "anon public")
STAGING_KEY=

# Cuenta de tesorero en staging (Authentication → Users)
STAGING_EMAIL=
STAGING_PASS=

# UUID de la cuenta en la tabla tesorero_cuentas
# (Table Editor → tesorero_cuentas → columna "id")
STAGING_CUENTA_ID=

# UUID del curso de prueba en la tabla cursos
# (Table Editor → cursos → columna "id", elige uno de staging)
STAGING_CURSO_ID=
