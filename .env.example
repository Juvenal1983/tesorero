# ============================================================
# El Tesorero — variables de entorno para pruebas de staging
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube al repositorio (está en .gitignore).
#
# ⚠️  Staging únicamente. NUNCA uses credenciales de producción:
#     Producción (NO TOCAR): https://tmjqzaakzhecbldebyeg.supabase.co
# ============================================================

# ── Obligatorias ──────────────────────────────────────────────
# URL del proyecto de staging
STAGING_URL=https://rucgmytyxpfowznowxwd.supabase.co

# Anon key del proyecto de staging
# (Supabase dashboard → proyecto → Settings → API → "anon public")
STAGING_KEY=

# Cuenta de tesorero en staging (Authentication → Users)
STAGING_EMAIL=
STAGING_PASS=

# ── Opcionales — el test las descubre solo si las omites ──────
# UUID en tesorero_cuentas (Table Editor → tesorero_cuentas → id)
# Si está vacío, el test usa la primera cuenta que devuelve RLS.
STAGING_CUENTA_ID=

# UUID del curso de prueba (Table Editor → cursos → id)
# Si está vacío, el test usa el primer curso activo,
# o crea uno temporal que eliminará al terminar.
STAGING_CURSO_ID=
