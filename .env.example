# ============================================================
# El Tesorero — variables de entorno para pruebas de staging
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube al repositorio (está en .gitignore).
#
# ⚠️  Staging únicamente. NUNCA uses credenciales de producción:
#     Producción (NO TOCAR): https://tmjqzaakzhecbldebyeg.supabase.co
# ============================================================
#
# Compatibilidad de nombres
# ─────────────────────────────────────────────────────────────
# Si ya tienes un .env anterior, los nombres viejos siguen funcionando.
# El test acepta ambos; el nombre nuevo tiene prioridad si ambos están.
#
#   Nombre nuevo (test:v9)       Nombre anterior (tests 03-07)
#   ───────────────────────────  ──────────────────────────────
#   STAGING_URL                  STAGING_SUPABASE_URL
#   STAGING_KEY                  STAGING_SUPABASE_ANON_KEY
#   STAGING_EMAIL                STAGING_USER_A_EMAIL
#   STAGING_PASS                 STAGING_USER_A_PASSWORD
#
# Para mantener un único .env que sirva para todos los tests,
# define los DOS nombres o solo el nuevo — como prefieras.
# ─────────────────────────────────────────────────────────────

# URL del proyecto de staging
# (Supabase dashboard → proyecto → Settings → API → "URL")
STAGING_URL=https://rucgmytyxpfowznowxwd.supabase.co
# STAGING_SUPABASE_URL=https://rucgmytyxpfowznowxwd.supabase.co   ← alias anterior

# Anon key de staging
# (Supabase dashboard → proyecto → Settings → API → "anon public")
STAGING_KEY=
# STAGING_SUPABASE_ANON_KEY=   ← alias anterior

# Email del tesorero de prueba en staging (Authentication → Users)
STAGING_EMAIL=
# STAGING_USER_A_EMAIL=   ← alias anterior

# Contraseña del tesorero de prueba
STAGING_PASS=
# STAGING_USER_A_PASSWORD=   ← alias anterior

# ── Variables usadas por los tests 03-07 (si los ejecutas también) ──────
# STAGING_APP_URL=https://...                  URL de la app desplegada en staging
# STAGING_USER_B_EMAIL=                        segundo usuario (pruebas RLS multi-cuenta)
# STAGING_USER_B_PASSWORD=
# STAGING_USER_C_EMAIL=                        usuario delegado
# STAGING_USER_C_PASSWORD=
# STAGING_USER_C_ROL=visor

# ── NO SE USA en test:v9 ─────────────────────────────────────────────────
# STAGING_CUENTA_ID y STAGING_CURSO_ID no son necesarios:
# el test crea su propio curso fixture en cada ejecución y lo borra al terminar.
